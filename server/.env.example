# Copy to server/.env for local runs. Never commit the filled-in file.
# Use a Stripe sandbox restricted key (rk_test_...) with Checkout Sessions read and write.
# Leave these blank in git. Fill them in locally or in the Render dashboard.

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
PUBLIC_BASE_URL=http://localhost:3000
PORT=3000

# Local browser preview only. Refuses to boot when NODE_ENV=production.
# STRIPE_MOCK=1
