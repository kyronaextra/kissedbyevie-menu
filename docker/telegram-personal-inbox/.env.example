# Copy to .env on your own machine. Never commit .env or session files.
# Generate your Telegram user API credentials from https://my.telegram.org
TELEGRAM_API_ID=0
TELEGRAM_API_HASH=
# One-time scoped connection key from Evie Admin > Message Inbox > Personal Telegram account
EVIE_INBOX_WORKER_TOKEN=
# Defaults to storing the secret Telegram session in ./private/account.session
TELEGRAM_SESSION_PATH=./private/account
# Read only the last message in up to 40 recent conversations at startup (0 disables).
TELEGRAM_BACKFILL_LIMIT=40
# off = only who and message type; snippet = first 160 characters stored privately.
TELEGRAM_MESSAGE_PREVIEW=off
